# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...

# What Jarvis calls you ("sir" is the default)
JARVIS_USER_NAME=Shubh
JARVIS_USER_TITLE=sir

# Model + server
JARVIS_MODEL=claude-opus-5-5
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
# Set this if you ever expose Jarvis to the internet (ngrok etc). UI will ask for it.
JARVIS_TOKEN=

# Let the engineering agent run shell commands inside ./workspace (0 = off)
JARVIS_ALLOW_EXEC=0

# --- Voice (optional) ---
# Without these, the browser's built-in British voice is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Texts & calls (optional, via Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public URL Twilio reaches you at, e.g. https://abc123.ngrok.app
PUBLIC_BASE_URL=
# "approve" = Jarvis drafts texts, you approve in the UI.  "auto" = Jarvis sends on his own.
COMMS_MODE=approve
